# Proteção do diretório de uploads
Options -Indexes

# Desativa execução de scripts PHP e CGI neste diretório
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Impede execução de handlers de script
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py
<Files *>
    SetHandler default-handler
</Files>

# Negar acesso web direto a extensões de dados e scripts
<FilesMatch "\.(json|php|phtml|phar|log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
