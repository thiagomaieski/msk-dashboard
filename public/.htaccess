# Bloqueia acesso direto a arquivos de configuração e dados sensíveis
<FilesMatch "^(config\.php|auth-helper\.php|\.env|.*\.log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes
