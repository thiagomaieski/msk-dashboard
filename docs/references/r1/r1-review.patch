+/* R1 shared components: scoped overrides for the legacy global cascade. */
+.ui-card, .ui-card-content, .ui-card-header { min-width: 0; }
+.ui-card-hover:hover { transform: translateY(-2px); box-shadow: var(--shadow-overlay); }
+.ui-button:not(:disabled):hover { filter: brightness(1.06); box-shadow: var(--shadow-card); }
+.ui-button:not(:disabled):active { transform: translateY(1px); }
+.ui-button:disabled { filter: none; }
+.ui-badge-clickable:hover { filter: brightness(1.1); }
+.ui-input::placeholder { color: var(--text3); opacity: 1; }
+.ui-input, body.light .ui-input { box-shadow: none; }
+.ui-input:focus, body.light .ui-input:focus { border-color: var(--accent); box-shadow: var(--focus-ring); }
+.ui-input.has-error:focus { border-color: var(--red); }
+.ui-table-wrap, body.light .ui-table-wrap { box-shadow: none; }
+.ui-table thead th, body.light .ui-table thead th { background: var(--surface-control); }
+.ui-table tbody tr:hover, body.light .ui-table tbody tr:hover { background: var(--surface-hover); }
+.ui-table tbody tr.active:hover { background: var(--accent-bg); }
