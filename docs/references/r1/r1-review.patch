+  backdrop-filter: var(--glass-filter);
+}
+.custom-select-item { min-height: 36px; border-radius: var(--radius-sm); }
+.custom-select-scroll-btn { background: var(--surface-floating); }
+.ui-modal-container > div, .ui-drawer-panel > div { flex-shrink: 0; }
+.ui-modal-container > div:nth-child(2), .ui-drawer-panel > div:nth-child(2) { flex-shrink: 1; min-height: 0; }
+.ui-modal-container > div:last-child, .ui-drawer-panel > div:last-child { flex-wrap: wrap; }
+#confirm-overlay { background: var(--scrim); backdrop-filter: blur(8px); z-index: var(--z-confirm); }
+.confirm-box { background: var(--surface-floating); border-color: var(--border-light); border-radius: var(--radius-modal); box-shadow: var(--shadow-overlay); max-height: calc(100dvh - 32px); overflow-y: auto; }
+.confirm-msg { font-size: 20px; font-weight: 700; }
+.confirm-btns .btn { min-height: 42px; border-radius: var(--radius-pill); }
+#toast { left: 50%; right: auto; bottom: max(24px, env(safe-area-inset-bottom)); transform: translateX(-50%); width: min(440px, calc(100vw - 28px)); align-items: center; z-index: var(--z-toast); }
+.toast-item { width: 100%; min-width: 0; max-width: 100%; background: var(--surface-floating); border-color: var(--border-light); border-radius: var(--radius-pill); box-shadow: var(--shadow-overlay); backdrop-filter: var(--glass-filter); transform: translateY(16px); }
+.toast-item.show { transform: translateY(0); }
+.toast-icon { border-radius: var(--radius-pill); }
+.toast-progress-track { left: 24px; right: 24px; }
+.ui-kit-page { width: 100%; padding: 32px; max-width: 1200px; margin: 0 auto; display: flex; flex-direction: column; gap: var(--grid-gap); }
+.ui-kit-page .ui-page-header { margin-bottom: 8px !important; }
+.ui-kit-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: var(--grid-gap); }
+.ui-kit-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
+.ui-kit-tile { padding: 18px; border-radius: var(--radius-tile); border: 1px solid var(--border-light); background: var(--surface-control); }
+.ui-kit-tile strong { display: block; font-size: 24px; font-weight: 600; }
+@keyframes ui-spin { to { transform: rotate(360deg); } }
+@keyframes ui-skeleton-shimmer { to { background-position: -200% 0; } }
+@media (max-width: 600px) {
+  :root { --font-control: 16px; --font-control-sm: 16px; }
+  .ui-kit-page { padding: 24px 14px; }
+  .ui-kit-page .ui-page-header > div { max-width: 100%; }
+  .ui-kit-page .ui-page-header h1 { overflow-wrap: anywhere; }
+  .ui-modal-portal { align-items: flex-end !important; padding: 12px !important; }
+  .ui-modal-container { max-height: 92dvh !important; }
+  .ui-drawer-portal { align-items: flex-end; }
+  .ui-drawer-panel { max-width: none !important; height: 88dvh !important; }
+  .custom-select-form .custom-select-value { font-size: 16px; }
+}
+@media (pointer: coarse) {
+  .ui-button, .custom-select-trigger { min-height: 44px !important; }
+  .ui-button-icon-only { min-width: 44px !important; }
+}
+@media (prefers-reduced-transparency: reduce) {
+  :root, body.light { --surface-glass: var(--surface-solid); --glass-filter: none; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .ui-card-hover:hover, .ui-button:not(:disabled):active { transform: none; }
+}
+@media (forced-colors: active) {
+  :focus-visible { outline: 2px solid Highlight !important; }
+  .ui-button, .ui-card, .custom-select-trigger { border: 1px solid ButtonText !important; }
+}
 
