+  padding: 10px 14px;
+  transition: background var(--t-fast), border-color var(--t-fast);
+}
+.custom-select-form, body.light .custom-select-form { min-height: 44px; border-radius: var(--radius-control); }
+.custom-select-trigger:hover:not(:disabled) { background: var(--surface-hover); }
+.custom-select-trigger:disabled { opacity: .45; cursor: not-allowed; }
+.custom-select-trigger:focus-visible { border-color: var(--accent); }
+.custom-select-value { font-size: var(--font-control); font-weight: 500; overflow: hidden; text-overflow: ellipsis; }
+.filter-chip.active .custom-select-value { color: var(--text); }
+.ui-select-wrapper.has-error .custom-select-trigger { border-color: var(--red); }
