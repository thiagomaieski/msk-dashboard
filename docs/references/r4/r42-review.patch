+.lead-lightbox .lightbox-split-img { width: 100%; max-width: 100%; height: auto; }
+.lead-lightbox .lightbox-split-right { width: auto; min-width: 0; border: 1px solid var(--border); border-radius: 18px; background: var(--surface-glass); color: var(--text); }
+.lead-lightbox .lightbox-split-header, .lead-lightbox .lightbox-split-body, .lead-lightbox .lightbox-split-footer { padding: 16px; }
+.lead-lightbox .lightbox-split-header h3 { color: var(--text); }
+.lead-lightbox .lightbox-split-header p, .lead-lightbox .lightbox-sidebar-label { color: var(--text2); }
+.lead-lightbox .lightbox-sidebar-textarea { background: var(--bg2); color: var(--text); border-color: var(--border); min-height: 220px; }
