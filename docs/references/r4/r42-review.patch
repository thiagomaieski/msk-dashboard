+.lead-drawer-nav button[aria-current] span { color: var(--accent); opacity: 1; }
+.lead-drawer-identity { display: flex; align-items: center; gap: 16px; padding: 20px; border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--border)); border-radius: 22px; background: linear-gradient(115deg, color-mix(in srgb, var(--accent) 12%, transparent), var(--surface-glass)); }
+.lead-drawer-avatar { width: 50px; height: 50px; border-radius: 17px; background: var(--color-accent); color: var(--on-accent); display: grid; place-items: center; flex-shrink: 0; font-size: 20px; font-weight: 700; }
