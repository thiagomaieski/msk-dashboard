+.lead-drawer-eyebrow { font-size: 11px; color: var(--text3); }
+.lead-drawer-identity h3 { font-size: 24px; line-height: 1.2; letter-spacing: -.025em; margin: 4px 0 6px; overflow-wrap: anywhere; }
+.lead-drawer-identity p { margin: 0; font-size: 13px; color: var(--text2); }
+.lead-drawer-section { display: flex; flex-direction: column; gap: 16px; animation: lead-section-in 160ms ease-out; }
+.lead-drawer-section[hidden] { display: none; }
+.lead-drawer-card { padding: 18px; border: 1px solid var(--border-light); border-radius: 22px; background: var(--surface-glass); box-shadow: inset 0 1px 0 var(--border-light); }
+.lead-drawer .form-grid { gap: 16px; }
+.lead-drawer .form-group { margin: 0; min-width: 0; gap: 7px; }
+.lead-drawer .form-label { font-size: 12px; text-transform: none; letter-spacing: 0; color: var(--text2); }
+.lead-drawer .form-input, .lead-drawer .form-select { min-height: 42px; border-radius: 14px; font-size: 13px; }
+.lead-drawer .form-textarea { border-radius: 14px; font-size: 13px; }
+.lead-drawer-details summary { cursor: pointer; font-size: 14px; font-weight: 600; color: var(--text); }
+.lead-drawer-details summary span { margin-left: 12px; font-size: 12px; font-weight: 400; color: var(--text3); }
+.lead-drawer-details[open] summary { margin-bottom: 20px; }
+.lead-drawer .btn { border-radius: 999px; min-height: 32px; }
+.lead-drawer #lead-panel-qualificacao > div:first-child { padding-bottom: 14px; border-bottom: 1px solid var(--border); gap: 14px !important; }
+.lead-drawer #lead-panel-qualificacao > div:first-child > div { flex-wrap: wrap; }
+.lead-drawer .prequal-speed-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
+.lead-drawer .prequal-screenshot-wrap { display: block; width: 100%; padding: 0; background: var(--bg2); border-radius: 16px !important; }
+.lead-drawer .prequal-screenshot-placeholder { min-height: 130px; display: grid; place-content: center; background: var(--bg2); border-radius: 16px !important; }
+.lead-drawer .prequal-screenshot-img { width: 100%; }
+.lead-drawer-timeline { display: flex; flex-direction: column; gap: 12px; }
+.lead-drawer-event { display: grid !important; grid-template-columns: 85px max-content 1fr 24px; gap: 10px !important; padding: 14px !important; border: 1px solid var(--border) !important; border-left: 3px solid var(--accent) !important; border-radius: 14px; background: var(--bg2); }
+.lead-drawer-event small { display: block; margin-top: 4px; font-size: 11px; }
+.lead-drawer-event > span { overflow-wrap: anywhere; }
+.lead-lightbox { max-width: min(1320px, calc(100vw - 32px)) !important; }
+.lead-lightbox-layout { display: grid; grid-template-columns: minmax(0, 3fr) minmax(240px, 1fr); min-height: 0; gap: 20px; }
+.lead-lightbox .lightbox-split-left { width: auto; padding: 0; min-width: 0; max-height: 70dvh; overflow: auto; background: var(--bg2); border-radius: 16px; }
